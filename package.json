{
  "name": "openhand",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5175 --strictPort --host 127.0.0.1",
    "lab": "vite --open /combat-lab.html --port 5175 --strictPort --host 127.0.0.1",
    "lab:ensure": "bash scripts/ensure-lab.sh",
    "typecheck:combat": "tsc --noEmit -p tsconfig.combat.json",
    "test:combat": "vitest run src/combatLab src/game/sim.test.ts src/game/board9.test.ts src/game/party.test.ts src/game/settings.test.ts src/game/codex.test.ts src/game/layerBoundary.test.ts src/game/goldenReplay.test.ts src/game/contentValidation.test.ts src/game/mech.test.ts src/game/guashow.test.ts src/game/role.test.ts --exclude src/combatLab/labMashBaseline.test.ts",
    "sim:climb": "vite-node scripts/climbSim/main.ts",
    "sim:climb:night": "vite-node scripts/climbSim/nightMain.ts",
    "sim:climb:night2": "vite-node scripts/climbSim/night2Main.ts",
    "sim:climb:night3": "vite-node scripts/climbSim/night3Main.ts",
    "sim:climb:night4": "vite-node scripts/climbSim/night4Main.ts",
    "sim:climb:night5": "vite-node scripts/climbSim/night5Main.ts",
    "sim:climb:night6": "vite-node scripts/climbSim/night6Main.ts",
    "sim:climb:night7": "vite-node scripts/climbSim/night7Main.ts",
    "sim:climb:night8": "vite-node scripts/climbSim/night8Main.ts",
    "sim:climb:night9": "vite-node scripts/climbSim/night9Main.ts",
    "sim:climb:night10": "vite-node scripts/climbSim/night10Main.ts",
    "sim:climb:night11": "vite-node scripts/climbSim/night11Main.ts",
    "sim:climb:night12": "vite-node scripts/climbSim/night12Main.ts",
    "sim:climb:night13": "vite-node scripts/climbSim/night13Main.ts",
    "sim:climb:night14": "vite-node scripts/climbSim/night14Main.ts",
    "sim:climb:night15": "vite-node scripts/climbSim/night15Main.ts",
    "sim:climb:night16": "vite-node scripts/climbSim/night16Main.ts",
    "lint:prose": "vite-node scripts/proseLint/main.ts",
    "test:balance": "vitest run src/combatLab/labMashBaseline.test.ts",
    "build:pages": "VITE_BASE=/openhand/ vite build",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
